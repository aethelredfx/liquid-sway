      "keys": "38;2;96;165;250",
      "title": "38;2;147;197;253",
      "output": "38;2;186;230;253"
    },
    "constants": [
      "\u001b[38;2;40;90;170m─────────────────\u001b[0m"
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2
    }
  },
  "modules": [
