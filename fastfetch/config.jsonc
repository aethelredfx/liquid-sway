      "type": "custom",
      "format": "\u001b[38;2;40;90;170m┌\u001b[0m{$1} \u001b[38;2;147;197;253mHardware Information\u001b[0m {$1}\u001b[38;2;40;90;170m┐\u001b[0m"
    },
