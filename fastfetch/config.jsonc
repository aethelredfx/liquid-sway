{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": {
      "1": "38;2;96;165;250",
      "2": "38;2;59;130;246"
    },
    "width": 45,
    "height": 20,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " \u001b[38;2;96;165;250m\u001b[0m ",
